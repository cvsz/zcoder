# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/

# Virtual environments
.venv/
.build-venv/
.web-venv/
venv/
env/

# Local model weights — mount at runtime, do not commit.
models/
*.gguf
*.gguf.*

# Env / secrets — never commit real credentials
.env
.env.*
!.env.example

# Code-signing certificates and private keys
certs/
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer

# Test / coverage / lint / type-check caches
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Build artifacts
build/
dist/
*.spec.bak

# Databases / test WAL artifacts
*.db
*.db-shm
*.db-wal

# Exact-SHA release qualification evidence is generated locally or in CI.
# Keep it out of source commits because the records must not change the SHA
# they validate.
/docs/evidence/release-evidence-*.json
/docs/evidence/pitr-qualification-*.json

# Local app state
.ai-coder/
.ai-coder-config.json
.web.pid
.api.pid
.worker.pid
.opencode.pid
.claude/
config.json
logs/

# Local installer / transfer artifacts
supabase-installer.zip

# Windows metadata files
*Zone.Identifier

# Supabase installer directory
deploy/supabase/

# Local review / transfer artifacts
*.patch
*:Zone.Identifier
/setup

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
