*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/

# Virtual environments
.venv/
.build-venv/
.web-venv/
venv/
env/

# Local model weights — mount at runtime, do not commit.
models/
*.gguf
