.env
.env.*
!.env.example

# Code-signing certificates and private keys
certs/
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer

# Test / coverage / lint / type-check caches
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Build artifacts
build/
dist/
*.spec.bak

# Databases / test WAL artifacts
*.db
*.db-shm
*.db-wal

# Local app state
.ai-coder/
.ai-coder-config.json
.web.pid
logs/

