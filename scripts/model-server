#!/usr/bin/env bash
# Wrapper for the ZCoder multi-sector GGUF model server controller.
# Usage: model-server {list|start|stop|restart|status|health} <sector|all>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Prefer the project venv (PyYAML lives there); fall back to system python3.
if [[ -x "$REPO_ROOT/.venv/bin/python" ]]; then
    PYTHON="$REPO_ROOT/.venv/bin/python"
else
    PYTHON="python3"
fi

exec "$PYTHON" "$SCRIPT_DIR/model_server.py" "$@"
