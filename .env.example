# ZCoder CLI — environment configuration
# Copy this file to .env and fill in your keys.

# Required for all Claude API features.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Only needed for --embed / --embed-file / --embed-similarity
# (claude_embeddings.py). Anthropic does not host its own embedding model;
# these commands call Voyage AI, Anthropic's documented embeddings partner.
# Get a key at https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Optional. Only needed if you use --gh-* (claude_github.py) commands.
GITHUB_TOKEN=

# Optional keys for multi-agent routing via --route --provider NAME.
# Availability of no-charge quotas depends on the provider and chosen model.
# See docs/guides/FREE-PROVIDER-ENDPOINTS.md before selecting a hosted model.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Optional router settings, leave unset to preserve the Anthropic default.
# ZCODER_PROVIDER=openrouter
# ZCODER_BASE_URL=http://localhost:1234/v1
