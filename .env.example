# ZCoder — local model and optional integration configuration
# Copy this file to .env. Keep real credentials out of version control.

# Docker Compose local inference. GGUF files are stored on the host in /zdata/models.
# Compose mounts this directory read-only at /models inside llama-server.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
ZCODER_MODELS_DIR=/zdata/models
ZCODER_GGUF_FILE=zcoder-7b-q4km.gguf
ZCODER_CTX_SIZE=4096
ZCODER_BASE_URL=http://127.0.0.1:8080/v1
# Optional host-side discovery root for the zGPU local GGUF catalog.
ZGPU_MODEL_DIRS=/zdata/models
ZCODER_MODEL=zcoder-7b-q4km
# Optional override for the host-side password file used by the ZCoder Compose
# service. Default: ${HOME}/.config/zcoder/postgresql.password
ZCODER_POSTGRES_SECRET_SOURCE=

# Local PostgreSQL (zpostgresql container on zPostgreSQL_network).
ZCODER_POSTGRES_HOST=zpostgresql
ZCODER_POSTGRES_PORT=5432
ZCODER_POSTGRES_USER=zcoder
# ZCODER_POSTGRES_PASSWORD — ตั้งค่าผ่านตัวแปรสภาพแวดล้อมหรือไฟล์ secrets เท่านั้น ห้ามฮาร์ดโค้ดในไฟล์นี้
# ZCODER_POSTGRES_PASSWORD=<your_strong_password>
ZCODER_POSTGRES_DB=zcoder_db
# DATABASE_URL — ตั้งค่าผ่านตัวแปรสภาพแวดล้อมใน production (รวมรหัสผ่าน) ห้ามฮาร์ดโค้ด
# DATABASE_URL=postgresql://zcoder:<your_strong_password>@zpostgresql:5432/zcoder_db

# Local Redis (zredis container on zPostgreSQL_network).
ZCODER_REDIS_HOST=zredis
ZCODER_REDIS_PORT=6379
# ZCODER_REDIS_PASSWORD — ตั้งค่าผ่านตัวแปรสภาพแวดล้อมหรือไฟล์ secrets เท่านั้น ห้ามฮาร์ดโค้ดในไฟล์นี้
# ZCODER_REDIS_PASSWORD=<your_strong_password>

# Optional. Only needed for --embed / --embed-file / --embed-similarity
# if the selected embedding adapter requires a remote credential.
# Get a key at https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Optional. Only needed for GitHub REST operations.
GITHUB_TOKEN=

# Optional keys for multi-agent routing via --route --provider NAME.
# Availability of no-charge quotas depends on the provider and chosen model.
# Local prompt and file flows use the configured GGUF model by default.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Fallback candidates are attempted in order after retryable failures or a model 404.
# Free-form model IDs are accepted; an OpenCode `nvidia/nvidia/...` prefix is normalized.
ZCODER_NVIDIA_MODELS=nvidia/nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b,nvidia/nvidia/nemotron-voicechat,nvidia/openai/gpt-oss-20b,nvidia/poolside/laguna-xs-2.1,nvidia/stepfun-ai/step-5-preview,nvidia/z-ai/glm-5.3-flash

# Optional router overrides. The default is the local llama.cpp endpoint.
# ZCODER_PROVIDER=openai_compatible
# ZCODER_BASE_URL=http://127.0.0.1:8080/v1
# Optional host-side discovery root for the zGPU local GGUF catalog.
ZGPU_MODEL_DIRS=/zdata/models
# For NVIDIA multi-agent routing, set ZCODER_ROUTE_PROVIDER=nvidia. Keep ZCODER_MODEL
# reserved for the local llama.cpp alias; NVIDIA uses ZCODER_NVIDIA_MODELS.

